NEXT_PUBLIC_APP_NAME="Shop & Warehouse"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Use the project's public anon key or current publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-public-key"

# Server only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-secret"
